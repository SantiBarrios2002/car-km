    (net (code 11) (name UART_TX)
      (node (ref J3) (pin 9)) (node (ref J4) (pin 1)))
    (net (code 12) (name UART_RX)
      (node (ref J3) (pin 10)) (node (ref J4) (pin 2)))
    (net (code 13) (name USB_CC1)
      (node (ref J1) (pin A5)) (node (ref R6) (pin 1)))
    (net (code 14) (name USB_CC2)
      (node (ref J1) (pin B5)) (node (ref R7) (pin 1)))
    (net (code 15) (name GND)
      (node (ref J1) (pin A1)) (node (ref J1) (pin A12)) (node (ref J1) (pin B1)) (node (ref J1) (pin B12)) (node (ref J1) (pin S1))
      (node (ref TVS1) (pin 2)) (node (ref R2) (pin 2)) (node (ref C1b) (pin 2)) (node (ref R5) (pin 2))
      (node (ref R6) (pin 2)) (node (ref R7) (pin 2))
      (node (ref C2) (pin 2)) (node (ref C3) (pin 2)) (node (ref J2) (pin 2))
      (node (ref J3) (pin 1)) (node (ref J3) (pin 5)) (node (ref J4) (pin 3)))))
