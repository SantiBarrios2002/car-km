(export (version D)
  (design
    (source "car-km carrier rev A (Waveshare ESP32-S3-Touch-LCD-2.8 carrier)")
    (tool "hand-written netlist; import into KiCad PCB via File > Import > Netlist, or use as the schematic spec"))
  (components
    (comp (ref J1)  (value USB-C_power_only) (footprint "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12"))
    (comp (ref F1)  (value PTC_1.1A)  (footprint "Fuse:Fuse_1812_4532Metric"))
    (comp (ref TVS1)(value SMAJ5.0A)  (footprint "Diode_SMD:D_SMA"))
    (comp (ref D1)  (value SS34)      (footprint "Diode_SMD:D_SMA"))
    (comp (ref JP1) (value "bypass D1 (open)")     (footprint "Jumper:SolderJumper-2_P1.3mm_Open_RoundedPad1.0x1.5mm"))
    (comp (ref JP2) (value "BAT->VCAP (closed)")   (footprint "Jumper:SolderJumper-2_P1.3mm_Bridged_RoundedPad1.0x1.5mm"))
    (comp (ref R1)  (value 100k)      (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref R2)  (value 47k)       (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref R4)  (value 10k)       (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref R5)  (value 10k)       (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref R6)  (value 5k1)       (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref R7)  (value 5k1)       (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref C1a) (value "5F 2.7V") (footprint "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm"))
    (comp (ref C1b) (value "5F 2.7V") (footprint "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm"))
    (comp (ref C2)  (value 10u)       (footprint "Capacitor_SMD:C_0805_2012Metric"))
    (comp (ref J2)  (value "JST PH 5 to PN532")  (footprint "Connector_JST:JST_PH_S5B-PH-K_1x05_P2.00mm_Horizontal"))
    (comp (ref J3)  (value "JST SH 12 to module J8") (footprint "Connector_JST:JST_SH_SM12B-SRSS-TB_1x12-1MP_P1.00mm_Horizontal"))
    (comp (ref J4)  (value UART_dbg)  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"))
    (comp (ref J5)  (value "1.25mm 2P to module J1 BAT") (footprint "Connector_JST:JST_GH_SM02B-GHS-TB_1x02-1MP_P1.25mm_Horizontal"))
    (comp (ref TP1) (value USB_5V)    (footprint "TestPoint:TestPoint_Pad_D1.5mm"))
    (comp (ref TP2) (value VCAP)      (footprint "TestPoint:TestPoint_Pad_D1.5mm"))
    (comp (ref R3)  (value "22R 1W DNP (fallback)") (footprint "Resistor_SMD:R_2512_6332Metric"))
    (comp (ref D2)  (value "SS34 DNP (fallback)")   (footprint "Diode_SMD:D_SMA"))
    (comp (ref H1)  (value M2.5) (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad"))
    (comp (ref H2)  (value M2.5) (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad"))
    (comp (ref H3)  (value M2.5) (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad"))
    (comp (ref H4)  (value M2.5) (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad")))
  (nets
    (net (code 1) (name VIN_CAR)
      (node (ref J1) (pin A4)) (node (ref J1) (pin A9)) (node (ref J1) (pin B4)) (node (ref J1) (pin B9))
      (node (ref F1) (pin 1)))
    (net (code 2) (name VIN_FUSED)
      (node (ref F1) (pin 2)) (node (ref TVS1) (pin 1)) (node (ref D1) (pin 2)) (node (ref R1) (pin 1)) (node (ref JP1) (pin 1)))
    (net (code 3) (name USB_5V)
      (node (ref D1) (pin 1)) (node (ref JP1) (pin 2)) (node (ref C2) (pin 1)) (node (ref J3) (pin 2))
      (node (ref TP1) (pin 1)) (node (ref R3) (pin 1)) (node (ref D2) (pin 1)))
    (net (code 4) (name PWR_SENSE)
      (node (ref R1) (pin 2)) (node (ref R2) (pin 1)) (node (ref J3) (pin 12)))
    (net (code 5) (name BAT)
      (node (ref J5) (pin 1)) (node (ref JP2) (pin 1)))
    (net (code 6) (name VCAP)
      (node (ref JP2) (pin 2)) (node (ref C1a) (pin 1)) (node (ref R4) (pin 1)) (node (ref TP2) (pin 1))
      (node (ref R3) (pin 2)) (node (ref D2) (pin 2)))
    (net (code 7) (name VCAP_MID)
      (node (ref C1a) (pin 2)) (node (ref C1b) (pin 1)) (node (ref R4) (pin 2)) (node (ref R5) (pin 1)))
    (net (code 8) (name 3V3)
      (node (ref J3) (pin 6)) (node (ref J2) (pin 1)))
    (net (code 9) (name SCL)
      (node (ref J3) (pin 7)) (node (ref J2) (pin 4)))
    (net (code 10) (name SDA)
      (node (ref J3) (pin 8)) (node (ref J2) (pin 3)))
    (net (code 11) (name NFC_IRQ)
      (node (ref J2) (pin 5)) (node (ref J3) (pin 11)))
    (net (code 12) (name UART_TX)
      (node (ref J3) (pin 9)) (node (ref J4) (pin 1)))
    (net (code 13) (name UART_RX)
      (node (ref J3) (pin 10)) (node (ref J4) (pin 2)))
    (net (code 14) (name USB_CC1)
      (node (ref J1) (pin A5)) (node (ref R6) (pin 1)))
    (net (code 15) (name USB_CC2)
      (node (ref J1) (pin B5)) (node (ref R7) (pin 1)))
    (net (code 16) (name GND)
      (node (ref J1) (pin A1)) (node (ref J1) (pin A12)) (node (ref J1) (pin B1)) (node (ref J1) (pin B12)) (node (ref J1) (pin SH))
      (node (ref TVS1) (pin 2)) (node (ref R2) (pin 2)) (node (ref C1b) (pin 2)) (node (ref R5) (pin 2))
      (node (ref R6) (pin 2)) (node (ref R7) (pin 2)) (node (ref C2) (pin 2))
      (node (ref J2) (pin 2)) (node (ref J3) (pin 1)) (node (ref J3) (pin 5)) (node (ref J3) (pin MP))
      (node (ref J4) (pin 3)) (node (ref J5) (pin 2)) (node (ref J5) (pin MP))
      (node (ref H1) (pin 1)) (node (ref H2) (pin 1)) (node (ref H3) (pin 1)) (node (ref H4) (pin 1)))))
