				(bold yes)
			)
			(justify left top)
		)
		(uuid "9ca6f693-367e-4dc7-9172-2b211433f3af")
	)
	(text "4  Module link: J3 -> Waveshare J8 (SH 1.0, 12 p)"
		(exclude_from_sim no)
		(at 177.8 106.68 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a3fe63a1-c61b-40d7-bada-2df0ab50fcac")
	)
	(text "J4.1 = module TXD (IO43) -> dongle RX\nJ4.2 = module RXD (IO44) <- dongle TX"
